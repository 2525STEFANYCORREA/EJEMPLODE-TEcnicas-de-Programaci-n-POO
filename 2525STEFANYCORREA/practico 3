using System;
using System.Collections.Generic;
using System.Linq;

namespace TorneoFutbol
{
    class Program
    {
        // ESTRUCTURAS DE DATOS - Teoria de Conjuntos y Mapas
        private static readonly Dictionary<int, string> Equipos = new();
        private static readonly HashSet<int> JugadoresUnicos = new();
        private static readonly Dictionary<int, Jugador> Jugadores = new();
        private static readonly HashSet<string> Personas = new(StringComparer.OrdinalIgnoreCase);
        private static readonly Dictionary<int, EstadisticaEquipo> TablaEquipos = new();
        
        private static int _nextEquipoId = 1;
        private static int _nextJugadorId = 1;
        private static readonly Random Rnd = new(123);

        static void Main()
        {
            Console.WriteLine("Torneo de Futbol - Conjuntos y Mapas");
            Console.WriteLine("Stefany Correa Avila - Universidad Estatal Amazonica");
            Console.WriteLine("Estructuras: Dictionary (Mapas) y HashSet (Conjuntos)\n");
            MenuPrincipal();
        }

        static void MenuPrincipal()
        {
            while (true)
            {
                Console.Clear();
                MostrarHeader();
                Console.WriteLine("1. Registrar equipo");
                Console.WriteLine("2. Registrar jugador");
                Console.WriteLine("3. Generar jugadores automaticamente");
                Console.WriteLine("4. Enlistar estructuras de datos");
                Console.WriteLine("5. Cantidades de estructuras");
                Console.WriteLine("6. Simular partido");
                Console.WriteLine("7. Tabla de posiciones");
                Console.WriteLine("8. Maximo goleador");
                Console.WriteLine("9. Consultas");
                Console.WriteLine("0. Salir");
                
                ProcesarOpcion(Console.ReadLine() ?? "");
            }
        }

        static void MostrarHeader()
        {
            Console.WriteLine($"Estado del Torneo");
            Console.WriteLine($"Equipos: {Equipos.Count} | Jugadores: {Jugadores.Count} | Personas: {Personas.Count}");
            Console.WriteLine(new string('=', 50));
        }

        static void ProcesarOpcion(string opcion)
        {
            return switch (opcion)
            {
                "1" => RegistrarEquipo(),
                "2" => RegistrarJugador(),
                "3" => GenerarJugadores(),
                "4" => MostrarEstructuras(),
                "5" => MostrarCantidades(),
                "6" => SimularPartido(),
                "7" => MostrarTabla(),
                "8" => MostrarMaxGoles(),
                "9" => Consultas(),
                "0" => Environment.Exit(0),
                _ => Pausa("Opcion invalida")
            };
        }

        #region OPERACIONES BASICAS
        static void RegistrarEquipo()
        {
            Console.Write("Nombre del equipo: ");
            var nombre = Console.ReadLine()?.Trim();
            if (string.IsNullOrEmpty(nombre)) { Pausa("Nombre invalido"); return; }
            
            var id = _nextEquipoId++;
            Equipos[id] = nombre;
            TablaEquipos[id] = new EstadisticaEquipo { Nombre = nombre };
            Console.WriteLine($"Equipo {id}: '{nombre}' registrado correctamente");
            Pausa();
        }

        static void RegistrarJugador()
        {
            if (!ListarEquipos()) return;
            
            if (int.TryParse(PedirTexto("ID del equipo: "), out var eqId) && Equipos.ContainsKey(eqId))
            {
                var nombre = PedirTexto("Nombre del jugador: ");
                if (!string.IsNullOrEmpty(nombre))
                {
                    var id = _nextJugadorId++;
                    Jugadores[id] = new Jugador { Nombre = nombre, EquipoId = eqId };
                    JugadoresUnicos.Add(id);
                    Personas.Add(nombre);
                    Console.WriteLine($"Jugador {id}: '{nombre}' registrado en equipo {eqId}");
                }
            }
            Pausa();
        }

        static void GenerarJugadores()
        {
            if (!ListarEquipos()) return;
            
            if (int.TryParse(PedirTexto("ID del equipo: "), out var eqId) && Equipos.ContainsKey(eqId))
            {
                if (int.TryParse(PedirTexto("Cantidad de jugadores (1-15): "), out var cant) && cant >= 1 && cant <= 15)
                {
                    var apellidos = new[] { "Gomez", "Lopez", "Rodriguez", "Martinez", "Garcia", "Hernandez" };
                    var nombres = new[] { "Juan", "Pedro", "Luis", "Carlos", "Diego", "Miguel" };
                    
                    for (var i = 0; i < cant; i++)
                    {
                        var nombreCompleto = $"{nombres[Rnd.Next(nombres.Length)]} {apellidos[Rnd.Next(apellidos.Length)]}";
                        var id = _nextJugadorId++;
                        Jugadores[id] = new Jugador { Nombre = nombreCompleto, EquipoId = eqId, Goles = 0 };
                        JugadoresUnicos.Add(id);
                        Personas.Add(nombreCompleto);
                    }
                    Console.WriteLine($"{cant} jugadores generados automaticamente para {Equipos[eqId]}");
                }
            }
            Pausa();
        }
        #endregion

        #region REPORTERIA
        static bool ListarEquipos()
        {
            if (!Equipos.Any())
            {
                Pausa("No hay equipos registrados");
                return false;
            }
            
            Console.WriteLine("\nEquipos disponibles:");
            foreach (var (id, nombre) in Equipos.OrderBy(e => e.Key))
                Console.WriteLine($"  ID {id}: {nombre} ({TablaEquipos[id].Puntos} puntos)");
            return true;
        }

        static void MostrarEstructuras()
        {
            Console.WriteLine("\nESTRUCTURAS DE DATOS:");
            Console.WriteLine("\nDICCIONARIOS (Mapas):");
            Console.WriteLine($"  Equipos: {Equipos.Count} elementos");
            if (Equipos.Any()) Console.WriteLine($"    {string.Join(", ", Equipos.Take(3).Select(e => $"{e.Key}:{e.Value}"))}");
            
            Console.WriteLine($"  Jugadores: {Jugadores.Count} elementos");
            if (Jugadores.Any()) Console.WriteLine($"    {string.Join(", ", Jugadores.Take(3).Select(j => $"{j.Key}:{j.Value.Nombre}"))}");
            
            Console.WriteLine("\nCONJUNTOS:");
            Console.WriteLine($"  Jugadores unicos: {JugadoresUnicos.Count}");
            Console.WriteLine($"  Personas unicas: {Personas.Count}");
            if (Personas.Any()) Console.WriteLine($"    {string.Join(", ", Personas.Take(5))}");
            
            Pausa();
        }

        static void MostrarCantidades()
        {
            Console.WriteLine("\nCANTIDADES DE ELEMENTOS:");
            Console.WriteLine($"Equipos registrados:           {Equipos.Count}");
            Console.WriteLine($"Jugadores totales:            {Jugadores.Count}");
            Console.WriteLine($"Jugadores unicos (HashSet):   {JugadoresUnicos.Count}");
            Console.WriteLine($"Personas unicas (HashSet):    {Personas.Count}");
            Console.WriteLine($"Partidos jugados total:       {TablaEquipos.Values.Sum(e => e.Partidos)}");
            Pausa();
        }

        static void Consultas()
        {
            Console.WriteLine("\n1. Consultar equipo  2. Consultar jugador  3. Verificar persona");
            switch (Console.ReadLine())
            {
                case "1" when int.TryParse(PedirTexto("ID equipo: "), out var eq) && Equipos.TryGetValue(eq, out var nombreEq):
                    Console.WriteLine($"{nombreEq} - Puntos: {TablaEquipos[eq].Puntos}, GF: {TablaEquipos[eq].GF}, GC: {TablaEquipos[eq].GC}"); 
                    break;
                case "2" when int.TryParse(PedirTexto("ID jugador: "), out var j) && Jugadores.TryGetValue(j, out var jugador):
                    Console.WriteLine($"Jugador {j}: {jugador.Nombre} - {jugador.Goles} goles"); 
                    break;
                case "3":
                    var persona = PedirTexto("Nombre: ");
                    Console.WriteLine(Personas.Contains(persona) ? "Persona registrada" : "Persona no encontrada");
                    break;
            }
            Pausa();
        }
        #endregion

        #region SIMULACION TORNEO
        static void SimularPartido()
        {
            if (Equipos.Count < 2) { Pausa("Se necesitan minimo 2 equipos"); return; }
            
            if (ListarEquipos() &&
                int.TryParse(PedirTexto("Equipo local ID: "), out var local) && Equipos.ContainsKey(local) &&
                int.TryParse(PedirTexto("Equipo visitante ID: "), out var visitante) && Equipos.ContainsKey(visitante) && local != visitante)
            {
                var golesLocal = Rnd.Next(0, 5);
                var golesVisitante = Rnd.Next(0, 5);
                
                ActualizarResultadoPartido(local, visitante, golesLocal, golesVisitante);
                DistribuirGolesEquipo(local, golesLocal);
                DistribuirGolesEquipo(visitante, golesVisitante);
                
                Console.WriteLine($"\nResultado: {Equipos[local]} {golesLocal} - {golesVisitante} {Equipos[visitante]}");
            }
            Pausa();
        }

        static void ActualizarResultadoPartido(int local, int visitante, int gLocal, int gVisitante)
        {
            TablaEquipos[local].GF += gLocal;   TablaEquipos[local].GC += gVisitante; TablaEquipos[local].Partidos++;
            TablaEquipos[visitante].GF += gVisitante; TablaEquipos[visitante].GC += gLocal; TablaEquipos[visitante].Partidos++;
            
            if (gLocal > gVisitante) TablaEquipos[local].Puntos += 3;
            else if (gVisitante > gLocal) TablaEquipos[visitante].Puntos += 3;
            else { TablaEquipos[local].Puntos++; TablaEquipos[visitante].Puntos++; }
        }

        static void DistribuirGolesEquipo(int equipoId, int goles)
        {
            var jugadoresEquipo = Jugadores.Values.Where(j => j.EquipoId == equipoId).ToList();
            if (jugadoresEquipo.Any())
            {
                var goleador = jugadoresEquipo[Rnd.Next(jugadoresEquipo.Count)];
                goleador.Goles += goles;
            }
        }

        static void MostrarTabla()
        {
            Console.WriteLine("\nTABLA DE POSICIONES");
            Console.WriteLine("Pos | Equipo          | Pts | GF:GC | DG");
            Console.WriteLine(new string('-', 45));
            
            var tabla = TablaEquipos.Values
                .OrderByDescending(e => e.Puntos)
                .ThenByDescending(e => e.DiferenciaGoles)
                .ThenBy(e => e.Nombre)
                .Select((e, i) => $"{i+1,3} | {e.Nombre,-12} | {e.Puntos,3} | {e.GF,2}:{e.GC,2} | {e.DiferenciaGoles,3}");

            foreach (var linea in tabla)
                Console.WriteLine(linea);
            Pausa();
        }

        static void MostrarMaxGoles()
        {
            Console.WriteLine("\nMAXIMOS GOLEADORES");
            var maxJugador = Jugadores.Values.OrderByDescending(j => j.Goles).FirstOrDefault();
            if (maxJugador != null)
                Console.WriteLine($"Jugador: {maxJugador.Nombre,-20} {maxJugador.Goles,3} goles");
            
            var maxEquipo = TablaEquipos.Values.OrderByDescending(e => e.GF).FirstOrDefault();
            if (maxEquipo != null)
                Console.WriteLine($"Equipo:  {maxEquipo.Nombre,-20} {maxEquipo.GF,3} goles a favor");
            
            Pausa();
        }
        #endregion

        #region UTILIDADES
        static string PedirTexto(string mensaje)
        {
            Console.Write(mensaje);
            return Console.ReadLine() ?? "";
        }

        static bool PausaRet(string mensaje = "Enter para continuar...")
        {
            Console.WriteLine(mensaje);
            Console.ReadLine();
            return true;
        }

        static void Pausa(string mensaje = "")
        {
            if (!string.IsNullOrEmpty(mensaje))
                Console.WriteLine(mensaje);
            Console.WriteLine("Enter para continuar...");
            Console.ReadLine();
        }
        #endregion
    }

    class Jugador
    {
        public string Nombre { get; init; } = "";
        public int EquipoId { get; init; }
        public int Goles { get; set; }

        public override string ToString() => $"{Nombre} ({Goles} goles)";
    }

    class EstadisticaEquipo
    {
        public string Nombre { get; init; } = "";
        public int Puntos { get; set; }
        public int GF { get; set; }  // Goles a favor
        public int GC { get; set; }  // Goles en contra
        public int Partidos { get; set; }

        public int DiferenciaGoles => GF - GC;

        public override string ToString() => $"{Nombre}: {Puntos} pts, {GF}:{GC}";
    }
}
